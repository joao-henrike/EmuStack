# Run ./scripts/host-setup.sh to create a local .env and per-environment directories.
PUID=1000
PGID=1000
# host-setup.sh generates a distinct EMUSTACK_AGENT_TOKEN_<ENV_ID> for each of the 20 agents.
# Do not create one shared agent token; keep the generated .env private.

# Optional build options.
# The Dockerfile defaults to an official Debian multi-architecture image digest pinned in Dockerfile.
# For a dated package repository snapshot as well, set this explicitly (it can miss later security fixes):
# APT_SNAPSHOT_TIMESTAMP=20261027T000000Z
# BUILD_KYTYPS5=0 disables the best-effort optional source build.
# KytyPS5 source build is fixed to an observed upstream release tag + commit prefix.
KYTYPS5_REF=KytyPS5-2026-10-26-f90a8b1
KYTYPS5_EXPECTED_SHORT=f90a8b1
# INSTALL_UPSTREAM=0 disables upstream release downloads for offline/fast builds.

# Resource ceilings: these are limits, not reserved memory. At most two console
environments are active by default (GPU/desktop RAM are shared infrastructure).
EMUSTACK_CPU_LIMIT=2
EMUSTACK_MEMORY_LIMIT=1g
EMUSTACK_PIDS_LIMIT=256
EMUSTACK_CLI_CPU_LIMIT=2
EMUSTACK_CLI_MEMORY_LIMIT=2g
EMUSTACK_CLI_PIDS_LIMIT=128
EMUSTACK_ENV_CPU_LIMIT=2
EMUSTACK_ENV_MEMORY_LIMIT=5g
EMUSTACK_ENV_PIDS_LIMIT=512
EMUSTACK_MAX_ACTIVE_ENVIRONMENTS=2
EMUSTACK_MAX_ACTIVE_PER_ENV=2

# Optional controller mapping. One device is passed read-only to exactly ONE env.
# Set both values deliberately; never point to a keyboard/mouse event node.
# EMUSTACK_INPUT_DEVICE=/dev/input/event7
# EMUSTACK_INPUT_ENV=rpcs3
